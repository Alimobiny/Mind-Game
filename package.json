{
  "name": "cognitive-training-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "آزمایشگاه تمرین شناختی — تمرین‌های شناختی تعاملی با پیگیری عملکرد (local-first)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "desktop": "electron electron/main.cjs",
    "desktop:build": "npm run icons && tsc --noEmit && vite build --base ./ && electron-builder --win portable nsis"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
